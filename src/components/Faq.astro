---
const questions = [
['Я не могу чётко сформулировать запрос. Это нормально?', 'Для начала достаточно рассказать о том, что вас беспокоит, или привести одну ситуацию. Формулировку запроса можно обсуждать уже на встрече.'],
['Нужно ли готовиться к первой встрече?', 'Можно записать то, о чём хочется поговорить, но это необязательно. Для онлайн-встречи стоит выбрать место, где вам будет удобно разговаривать.'],
['Нужно ли сразу решать, сколько встреч мне нужно?', 'В этой концепции нет обязательного пакета. Возможное продолжение, цели и частота обсуждаются после знакомства. Заранее обещать точное число встреч было бы некорректно.'],
['Что, если я пойму, что мне не подходит?', 'Об этом можно сказать прямо. Важно иметь возможность обсуждать свои сомнения и принимать решение о продолжении без давления.'],
['Можно ли действительно записаться на этом сайте?', 'Нет. Это работа для портфолио: Анна Ветрова — вымышленный эксперт, фотографии иллюстративные, цена и условия демонстрационные. Сценарий записи не собирает и не отправляет персональные данные.']
];
---
<section class="section container split faq" aria-labelledby="faq-title"><div><p class="eyebrow">06 / ОСТАЛИСЬ ВОПРОСЫ</p><h2 id="faq-title">До начала<br />работы</h2></div><div>{questions.map(([question,answer]) => <details><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</div></section>
