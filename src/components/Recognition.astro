---
const situations = [
  ['Отдыхаете, но не отдыхаете', 'Даже в свободный вечер кажется, что нужно сделать ещё что-то полезное.'],
  ['Говорите «да», когда сил уже нет', 'Проще согласиться, чем выдержать чужое разочарование или объяснить свой отказ.'],
  ['Замечаете ошибки раньше успехов', 'Одна неудача надолго остаётся в голове. Всё, что получилось, будто не считается.'],
  ['Для всех находится время. Для себя — потом', 'Вы хорошо знаете, чего от вас ждут. А собственные желания услышать сложнее.']
];
---
<section class="section container split" id="recognition" aria-labelledby="recognition-title"><div class="section-heading"><p class="eyebrow">01 / УЗНАТЬ СЕБЯ</p><h2 id="recognition-title">Возможно,<br />вам знакомо</h2><p class="aside-note">Не обязательно ждать момента,<br />когда станет совсем тяжело.</p></div><div class="situations">{situations.map(([title, text]) => <article class="situation"><h3>{title}</h3><p>{text}</p></article>)}</div></section>
