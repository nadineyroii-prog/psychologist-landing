---
const steps = [ ['01', 'Познакомимся', 'Можно рассказать о конкретной ситуации или начать с «я не знаю, с чего начать». Готовить правильные слова не нужно.'], ['02', 'Обсудим ваш запрос', 'Уточним, что сейчас трудно и чего вам хотелось бы от консультаций. Вы сможете задать свои вопросы.'], ['03', 'Наметим следующий шаг', 'Обсудим, подходит ли вам формат и хотите ли вы продолжать. Решение о дальнейших встречах принимается вместе.'] ];
---
<section class="section container meeting" id="meeting" aria-labelledby="meeting-title"><div class="split meeting-heading"><div><p class="eyebrow">04 / ПЕРВАЯ ВСТРЕЧА</p><h2 id="meeting-title">Начать можно<br />с любого места</h2></div><p>Первая встреча — возможность познакомиться и понять, как может быть устроена работа. Она не обязывает к длительному курсу.</p></div><div class="steps">{steps.map(([n,title,text]) => <article><span class="step-number">{n}</span><h3>{title}</h3><p>{text}</p></article>)}</div></section>
